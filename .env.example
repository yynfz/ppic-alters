# Environment variables for PPIC Alter-S (v1.1 — WorkBuddy-First + Supabase)
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# ─── Demo data paths ──────────────────────────────────────────────────────────
DEMO_DATA_DIR=./demo-data
DEMO_ORDER_ID=MO-001

# Deterministic calculation script
COMPUTE_SCRIPT=./backend/compute_shortage.py

# ─── Supabase (optional — enables database mode) ──────────────────────────────
# If these are set, the backend reads from Supabase Postgres instead of CSVs.
# If left empty, the backend falls back to CSV file mode automatically.
# Create a project at https://supabase.com, run db/migrations + db/seed, then
# copy the URL and service role key from Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Alternative: use anon key for read-only access
# SUPABASE_ANON_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Model for CodeBuddy Agent SDK (leave empty for default)
PPIC_MODEL=

# ─── WorkBuddy (if using MCP / HTTP path — optional) ──────────────────────────
WORKBUDDY_MCP_URL=
MCP_SERVER_MODE=stdio

# ─── Submission ───────────────────────────────────────────────────────────────
DEMO_TENANT=DEMO
