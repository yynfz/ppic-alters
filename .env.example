# Environment variables for PPIC Alter-S (v1.1 — WorkBuddy-First)
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# Demo data paths
DEMO_DATA_DIR=./demo-data
DEMO_ORDER_ID=MO-001

# Deterministic calculation script
COMPUTE_SCRIPT=./demo-data/compute_shortage.py

# WorkBuddy (if using MCP / HTTP path — optional)
WORKBUDDY_MCP_URL=
MCP_SERVER_MODE=stdio

# Review UI (optional, only if approval view is built)
DEMO_REVIEW_UI_PORT=3000

# Submission
DEMO_TENANT=DEMO
