# Environment variables for PPIC Alter-S
# Copy to .env and fill in your values. NEVER commit the real .env file.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── CodeBuddy Agent SDK ──────────────────────────────────────────────────────
# Model credential for the agent. Without it the app runs in deterministic
# mode (same engine, same guardrails, no language model).
# Get a key: https://www.codebuddy.ai/profile/keys
CODEBUDDY_API_KEY=

# Reuse a desktop `codebuddy` login instead of an API key.
# PPIC_FORCE_SDK=1

# Optional model override (leave empty for the account default).
PPIC_MODEL=

# Optional: isolate the SDK's CLI config directory.
# PPIC_SDK_CONFIG_DIR=./.codebuddy-sdk

# ─── Demo data ────────────────────────────────────────────────────────────────
# Directory holding orders.csv, bom.csv and inventory.csv.
# Defaults to ./demo-data when unset.
DEMO_DATA_DIR=

# ─── Supabase (optional, not used by the Agent Web app) ───────────────────────
# The chat app reads the CSV demo dataset. These are for the DB variant.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
