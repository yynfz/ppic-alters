# Environment variables for PPIC Alter-S
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# Backend
PPIC_BACKEND_PORT=8080
PPIC_DATA_SOURCE=sqlite
PPIC_DB_PATH=./demo-data/ppic.db

# MCP Server
MCP_SERVER_MODE=stdio
MCP_SERVER_PORT=9090

# WorkBuddy (if using HTTP MCP)
WORKBUDDY_MCP_URL=

# Demo
DEMO_TENANT=DEMO
DEMO_REVIEW_UI_PORT=3000
